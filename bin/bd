#!/bin/sh
# bd — beads dispatch: a transparent wrapper around `br`.
#
#  (A) ROUTING. A fully-qualified bead ID ("<repo>-...") is routed to THAT
#      repo's home DB via --db, so `bd update taher-core-scope-8cda --claim`
#      works from ANY cwd (another repo, a worktree, or ~/dev). Plain `br` only resolves
#      the cwd's .beads DB. Repos are DISCOVERED: every dir under $DEV_ROOT
#      (default ~/dev) that contains .beads/, matched longest-prefix-first.
#      Convention: repo dir name == bead id prefix.
#
#  (B) ACTOR. Mutating verbs get a session-distinct --actor derived from the
#      current git branch (parallel sessions live on their own branches), so
#      concurrent claims by the same human are distinguishable.
#      BEADS_ACTOR (env) takes precedence over the branch-derived actor.
#
# Transparent superset of br: explicit --db/--actor are honored; with no
# foreign ID and no mutating verb it's a pass-through.
# BD_BR_OVERRIDE points at an alternative br binary (used by tests).

set -u

BR=""
if [ -n "${BD_BR_OVERRIDE:-}" ]; then
  [ -x "$BD_BR_OVERRIDE" ] || { echo "bd: BD_BR_OVERRIDE not executable: $BD_BR_OVERRIDE" >&2; exit 1; }
  BR="$BD_BR_OVERRIDE"
fi
[ -n "$BR" ] || BR="$HOME/.local/bin/br"
[ -x "$BR" ] || BR="$(command -v br 2>/dev/null || echo br)"

DEV="${DEV_ROOT:-$HOME/dev}"

# Discover beads repos: dirs under $DEV with a .beads dir, longest name first
# (so taher-core-extra wins over taher-core for id "taher-core-extra-1").
# NOTE: relies on the convention that repo dir names have no whitespace.
REPOS=$(for d in "$DEV"/*/.beads; do
  [ -d "$d" ] || continue
  basename "$(dirname "$d")"
done | awk '{ print length, $0 }' | sort -rn | cut -d' ' -f2-)

have_db=0
have_actor=0
verb=""
for a in "$@"; do
  case "$a" in
    --db|--db=*) have_db=1 ;;
    --actor|--actor=*) have_actor=1 ;;
  esac
done
skip_next=0
for a in "$@"; do
  if [ "$skip_next" -eq 1 ]; then skip_next=0; continue; fi
  case "$a" in
    --db|--actor) skip_next=1 ;;
    -*) ;;
    *) verb="$a"; break ;;
  esac
done

# (A) Resolve a foreign-prefix bead ID to its home DB (unless --db is explicit).
db=""
if [ "$have_db" -eq 0 ]; then
  for a in "$@"; do
    for r in $REPOS; do
      case "$a" in
        "$r"-*)
          cand="$DEV/$r/.beads/beads.db"
          [ -f "$cand" ] && db="$cand"
          break
          ;;
      esac
    done
    [ -n "$db" ] && break
  done
fi

# (B) Session-distinct actor for mutating verbs (unless --actor is explicit).
actor=""
if [ "$have_actor" -eq 0 ]; then
  case "$verb" in
    update|close|create|comment|comments|delete|dep|deps|q|reopen)
      actor="${BEADS_ACTOR:-}"
      [ -z "$actor" ] && actor="$(git branch --show-current 2>/dev/null || true)"
      [ -z "$actor" ] && actor="${USER:-agent}"
      ;;
  esac
fi

# ${x:+--flag} ${x:+"$x"}: expands to nothing when x is empty, keeping pass-through clean.
exec "$BR" ${db:+--db} ${db:+"$db"} ${actor:+--actor} ${actor:+"$actor"} "$@"
